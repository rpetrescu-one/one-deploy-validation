<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OpenNebula Cloud Verification Report</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600;700&display=swap');
  :root{--one-blue:#1a7ba4;--one-blue-light:#e8f4f9;--one-blue-mid:#c2dfed;--bg:#fff;--surface:#f8fafc;--surface2:#f1f5f9;--border:#e2e8f0;--text:#0f172a;--muted:#64748b;--pass:#15803d;--pass-bg:#f0fdf4;--pass-bd:#bbf7d0;--fail:#b91c1c;--fail-bg:#fef2f2;--fail-bd:#fecaca;--warn:#b45309;--warn-bg:#fffbeb;--warn-bd:#fde68a;--info:#1e40af;--info-bg:#eff6ff;--info-bd:#bfdbfe;--mono:'IBM Plex Mono',monospace}
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:'IBM Plex Sans',sans-serif;font-size:14px;line-height:1.6}
  .wrap{max-width:1080px;margin:0 auto;padding:40px 24px}
  .header{display:flex;align-items:center;gap:24px;padding:24px 32px;background:var(--bg);border:1px solid var(--border);border-left:4px solid var(--one-blue);border-radius:10px;margin-bottom:24px}
  .header-logo img{height:52px;width:auto;display:block}
  .header-div{width:1px;height:52px;background:var(--border);flex-shrink:0}
  .hm{flex:1}.hm h1{font-size:19px;font-weight:700;margin-bottom:4px}.hm p{color:var(--muted);font-size:12px;line-height:1.8}.hm strong{color:var(--one-blue)}
  .header-meta{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
  .role-pill{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:11px;font-weight:700;font-family:var(--mono);letter-spacing:.5px;background:var(--one-blue-light);border:1px solid var(--one-blue-mid);color:var(--one-blue)}
  .ts{font-size:11px;color:var(--muted);font-family:var(--mono)}
  .banner{padding:13px 20px;border-radius:8px;margin-bottom:24px;display:flex;align-items:center;gap:12px;font-weight:600;font-size:14px;border-left-width:4px;border-left-style:solid}
  .status-pass{background:var(--pass-bg);border-color:var(--pass);color:var(--pass)}.status-fail{background:var(--fail-bg);border-color:var(--fail);color:var(--fail)}.status-warn{background:var(--warn-bg);border-color:var(--warn);color:var(--warn)}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:18px 16px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96px}.card .num{display:block;width:100%;text-align:center;font-size:32px;font-weight:700;font-family:var(--mono);line-height:1;margin-bottom:4px}.card .lbl{display:block;width:100%;text-align:center;font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
  .cp{border-top:3px solid var(--pass)}.cp .num{color:var(--pass)}.cf{border-top:3px solid var(--fail)}.cf .num{color:var(--fail)}.cw{border-top:3px solid var(--warn)}.cw .num{color:var(--warn)}.ct{border-top:3px solid var(--one-blue)}.ct .num{color:var(--one-blue)}
  .pgwrap{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:18px 20px;margin-bottom:24px}.pglbl{display:flex;justify-content:space-between;margin-bottom:8px;font-size:12px;color:var(--muted);font-weight:600}.pgbar{height:8px;background:var(--border);border-radius:999px;overflow:hidden}.pgfill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--pass),var(--one-blue));transition:width .9s cubic-bezier(.4,0,.2,1)}
  .arch-section{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:20px;margin-bottom:24px}.arch-fe{text-align:center;padding:10px 20px;background:var(--one-blue-light);border:1px solid var(--one-blue-mid);border-radius:8px;margin:0 auto 6px;width:230px;color:var(--one-blue);font-weight:700;font-family:var(--mono);font-size:12px}.arch-fe small{display:block;color:var(--text);font-size:11px;font-weight:400;margin-top:3px}.ac{text-align:center;color:var(--muted);font-family:var(--mono);line-height:1.2}.anet{text-align:center;padding:7px;border-radius:4px;margin:3px 0;font-size:11px;font-weight:600;letter-spacing:.5px;font-family:var(--mono)}.nm{background:var(--pass-bg);border:1px solid var(--pass-bd);color:var(--pass)}.ns{background:var(--warn-bg);border:1px solid var(--warn-bd);color:var(--warn)}.np{background:var(--info-bg);border:1px solid var(--info-bd);color:var(--info)}.anodes{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:6px 0}.anode{padding:10px;background:#faf5ff;border:1px solid #e9d5ff;border-radius:6px;text-align:center;color:#7c3aed;font-size:11px;font-family:var(--mono)}.anode strong{display:block;color:var(--text);font-size:12px;margin-bottom:3px}
  .rst-section,.data-section{margin-bottom:24px}.rst-header{width:100%;padding:11px 16px;background:var(--surface2);border:1px solid var(--border);border-bottom:none;border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;text-align:left}.rst-header h3,.section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}.tog{color:var(--muted);font-size:16px;font-family:var(--mono)}
  .rtable,.gtable{width:100%;border-collapse:collapse;border:1px solid var(--border)}.rtable{border-radius:0 0 8px 8px;overflow:hidden}.rtable td,.gtable td{padding:11px 14px;border-bottom:1px solid var(--border);vertical-align:top;font-size:13px}.rtable tr:last-child td,.gtable tr:last-child td{border-bottom:none}.rtable tr:hover td,.gtable tr:hover td{background:var(--surface)}.gtable th{padding:8px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);border-bottom:2px solid var(--border);text-align:left;font-weight:700;background:var(--surface2)}.bench-table{table-layout:fixed;min-width:620px}.net-table{width:max-content;min-width:1100px;table-layout:auto}.net-table th,.net-table td{white-space:nowrap}
  .status-cell{width:96px}.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;font-family:var(--mono);white-space:nowrap}.bp{background:var(--pass-bg);color:var(--pass);border:1px solid var(--pass-bd)}.bf{background:var(--fail-bg);color:var(--fail);border:1px solid var(--fail-bd)}.bw{background:var(--warn-bg);color:var(--warn);border:1px solid var(--warn-bd)}.bi{background:var(--info-bg);color:var(--info);border:1px solid var(--info-bd)}.score-cell{font-size:20px;font-weight:700;line-height:1;text-align:center;font-family:'IBM Plex Sans',sans-serif}
  .cn{font-weight:600;color:var(--text)}.cd{color:var(--muted);font-family:var(--mono);font-size:11px;margin-top:2px;word-break:break-word;white-space:pre-wrap}.comment{margin-top:8px;padding:9px 12px;background:#fefce8;border:1px solid #fde68a;border-left:3px solid #d97706;border-radius:6px;font-size:12px;color:#78350f;line-height:1.6}.comment-lbl{font-weight:700;color:#b45309;margin-right:6px;font-family:var(--mono);font-size:11px}
  .subtable{width:100%;border-collapse:collapse;margin-top:8px;border:1px solid var(--border);background:#fff}.subtable th,.subtable td{padding:8px 10px;border-bottom:1px solid var(--border);font-size:12px;vertical-align:middle}.subtable tr:last-child td{border-bottom:none}.subtable th{background:var(--surface2);color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-size:10px;font-weight:700;text-align:left}.subtable td.num,.subtable th.num{text-align:right}.subblock{margin-top:8px}.mono{font-family:var(--mono)}.record-table{table-layout:fixed}.record-table th[scope="row"]{width:34%}.record-table td{text-align:center}
  .data-section{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:20px}.data-section .section-title{margin-bottom:14px}.table-scroll{overflow-x:auto;display:block;max-width:100%}.mini-pre,pre{padding:12px 14px;background:#fff;border:1px solid var(--border);border-left:3px solid var(--one-blue);border-radius:6px;font-family:var(--mono);font-size:11px;color:var(--muted);line-height:1.7;overflow:auto;white-space:pre-wrap}.mini-pre{margin-top:4px;max-height:260px}pre{max-height:560px}.num{text-align:right;font-family:var(--mono)}.matrix-ok{background:var(--pass-bg);color:var(--pass);font-family:var(--mono);font-weight:600}.matrix-bad{background:var(--fail-bg);color:var(--fail);font-family:var(--mono);font-weight:600}.matrix-warn{background:var(--warn-bg);color:var(--warn);font-family:var(--mono);font-weight:600}
  #table-networks td:last-child{max-width:0}
  .page-break{break-after:page;page-break-after:always}
  .doc-page{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:28px 32px;margin-bottom:24px}
  .doc-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:28px}
  .doc-brand .cover-logo{height:42px;width:auto;display:block}
  .doc-confidential{font-size:11px;font-weight:700;letter-spacing:.8px;color:var(--fail);font-family:var(--mono);text-transform:uppercase}
  .cover-title{font-size:34px;line-height:1.15;font-weight:700;margin-bottom:28px;color:var(--text)}
  .cover-meta{width:100%;border-collapse:collapse;margin-bottom:24px}
  .cover-meta th,.cover-meta td{padding:10px 12px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:top}
  .cover-meta th{width:180px;background:var(--surface2);text-align:left;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-size:11px}
  .cover-abstract{margin-bottom:24px;font-size:13px;color:var(--text);line-height:1.8}
  .toc-list{list-style:none;padding:0;margin:16px 0 0}
  .toc-list li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px}
  .toc-list .toc-label{color:var(--text)}
  .toc-list .toc-page{color:var(--muted);font-family:var(--mono)}
  .summary-table{width:100%;border-collapse:collapse}
  .summary-table th,.summary-table td{padding:10px 12px;border:1px solid var(--border);font-size:13px;vertical-align:top}
  .summary-table th{width:220px;background:var(--surface2);text-align:left;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-size:11px}
  .footer{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid var(--border);font-size:12px;color:var(--muted)}.footer a{color:var(--one-blue);text-decoration:none}.footer a:hover{text-decoration:underline}
  .chart-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin-top:12px}
  .chart-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:6px}
  .chart-legend{display:flex;flex-wrap:wrap;gap:14px;font-size:11px;color:var(--muted);margin-bottom:6px;font-family:var(--mono)}
  .chart-legend .sw{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
  .chart-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  @media(max-width:760px){.chart-row{grid-template-columns:1fr}}
  @media(max-width:640px){.cards{grid-template-columns:repeat(2,1fr)}.anodes{grid-template-columns:1fr}.header{flex-direction:column;align-items:flex-start}.header-meta{align-items:flex-start}.footer{flex-direction:column;gap:12px;align-items:flex-start}}
  @media print{
    body{background:#fff}
    .wrap{padding:8px}
    .rst-header{cursor:default}
    .tog{display:none}
    .header{gap:14px;padding:12px 16px;margin-bottom:8px}
    .header-logo img{height:38px}
    .header-div{height:38px}
    .hm h1{font-size:16px;margin-bottom:2px}
    .hm p{font-size:10px;line-height:1.45}
    .header-meta{gap:3px}
    .role-pill{padding:3px 10px;font-size:10px}
    .ts{font-size:10px}
    .banner{margin-bottom:8px;padding:7px 12px;font-size:12px}
    .cards{margin-bottom:8px;gap:8px}
    .card{min-height:62px;padding:10px 8px}
    .card .num{font-size:22px;margin-bottom:2px}
    .card .lbl{font-size:9px}
    .pgwrap{padding:8px 12px;margin-bottom:8px}
    .pglbl{margin-bottom:4px;font-size:10px}
    .pgbar{height:6px}
	    .arch-section,.arch-fe,.anodes,.anode,.anet{break-inside:avoid;page-break-inside:avoid}
    .doc-page,.cover-meta,.summary-table,.toc-list,.toc-list li{break-inside:avoid;page-break-inside:avoid}
    .gtable th{padding:4px 5px;font-size:8px;letter-spacing:.3px}
    .gtable td{padding:4px 5px;font-size:9px}
    .chart-card{break-inside:avoid;page-break-inside:avoid;padding:8px 10px;margin-top:8px}
    .chart-row{break-inside:avoid;page-break-inside:avoid}
    .chart-legend{font-size:9px;gap:10px;margin-bottom:4px}
    .chart-title{font-size:9px;margin-bottom:4px}
	    .arch-section{padding:8px 10px;margin-bottom:10px}
	    .arch-section .section-title{margin-bottom:4px;font-size:10px}
	    .arch-fe{width:180px;margin-bottom:2px;padding:5px 10px;font-size:10px}
	    .arch-fe small{font-size:9px;margin-top:1px}
	    .ac{line-height:1}
	    .anet{margin:1px 0;padding:3px;font-size:9px}
	    .anodes{gap:6px;margin:2px 0}
	    .anode{padding:5px;font-size:9px}
	    .anode strong{font-size:10px;margin-bottom:1px}
    .doc-page{padding:18px 22px}
    .doc-topline{margin-bottom:18px}
    .doc-brand .cover-logo{height:34px}
    .doc-confidential{font-size:9px}
    .cover-title{font-size:28px;margin-bottom:20px}
    .cover-meta th,.cover-meta td,.summary-table th,.summary-table td,.toc-list li{font-size:11px}
    .cover-meta th,.summary-table th{font-size:9px}
    .cover-abstract{font-size:11px;line-height:1.55;margin-bottom:18px}
	  }
</style>
</head>
<body>

{% macro status_from(value, comment='') -%}
  {%- set text = ((value | string) ~ ' ' ~ (comment | default('') | string)) | lower -%}
  {%- if 'unreachable' in text or 'inactive' in text or 'failed' in text or 'error' in text or (text | regex_search('(^|[^a-z])fault([^a-z]|$)')) -%}fail
  {%- elif 'warning' in text or 'skipped' in text or 'unknown' in text or ' n/a' in text -%}warn
  {%- elif value == 'ok' or value == 'reachable' or value == 'active' or value == 'enabled' or value == 'running' or 'ok -' in text or 'state=running' in text or ('packet_loss_percent' in text and ('packet_loss_percent": 0.0' in text or "packet_loss_percent': 0.0" in text or 'packet_loss_percent: 0.0' in text)) -%}pass
  {%- else -%}info
  {%- endif -%}
{%- endmacro %}

{% macro badge(status) -%}
  {%- if status == 'pass' -%}<span class="badge bp">PASS</span>
  {%- elif status == 'fail' -%}<span class="badge bf">FAIL</span>
  {%- elif status == 'warn' -%}<span class="badge bw">WARN</span>
  {%- else -%}<span class="badge bi">INFO</span>
  {%- endif -%}
{%- endmacro %}

{% macro render_value(value) -%}
  {%- if value is mapping or (value is sequence and value is not string) -%}
    <pre class="mini-pre">{{ value | to_nice_json }}</pre>
  {%- else -%}
    {%- set value_text = value | string -%}
    {%- if '\n' in value_text or value_text | trim | regex_search('^[{[]') -%}<pre class="mini-pre">{{ value_text }}</pre>
    {%- else -%}<div class="cd">{{ value_text }}</div>
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}

{% macro render_simple_list_table(values, label) -%}
  <table class="subtable">
    <thead><tr><th>{{ label }}</th></tr></thead>
    <tbody>
      {%- for item in values %}
      <tr><td>{{ item }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
{%- endmacro %}

{% macro render_kvm_hosts_table(values) -%}
  <table class="subtable">
    <thead><tr><th>Host</th><th>ID</th><th>State</th></tr></thead>
    <tbody>
      {%- for item in values %}
      <tr>
        <td>{{ item.hostname | default(item.name | default('N/A')) }}</td>
        <td class="mono">{{ item.id | default('N/A') }}</td>
        <td class="mono">{{ item.state | default('N/A') }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
{%- endmacro %}

{% macro render_record_table(title, rows) -%}
  <div class="subblock">
    {% if title != '' %}<div class="cd"><strong>{{ title }}</strong></div>{% endif %}
      <table class="subtable record-table">
        <thead><tr><th>Metric</th><th>Value</th></tr></thead>
        <tbody>
        {% for row in rows %}
          <tr><th scope="row">{{ row.label }}</th><td class="{{ 'mono' if row.mono | default(false) else '' }}">{{ row.value }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
  </div>
{%- endmacro %}

{% macro render_ping_record_table(title, test_vm_ip, value) -%}
  {{ render_record_table(title, [
    {'label': 'Test VM IP', 'value': test_vm_ip, 'mono': true},
    {'label': 'Destination IP', 'value': value.destination_ip | default('N/A'), 'mono': true},
    {'label': 'Data Bytes', 'value': value.data_bytes | default('N/A')},
    {'label': 'Destination', 'value': value.destination | default('N/A')},
    {'label': 'Response IP', 'value': value.responses[0].response_ip if value.responses is defined and (value.responses | length) > 0 else (value.destination_ip | default('N/A')), 'mono': true},
    {'label': 'Packets Transmitted', 'value': value.packets_transmitted | default('N/A')},
    {'label': 'Packets Received', 'value': value.packets_received | default('N/A')},
    {'label': 'Packet Loss %', 'value': value.packet_loss_percent | default('N/A')},
    {'label': 'Average RTT (ms)', 'value': value.round_trip_ms_avg | default('N/A')},
    {'label': 'Maximum RTT (ms)', 'value': value.round_trip_ms_max | default('N/A')}
  ]) }}
{%- endmacro %}

{% macro render_dns_record_table(title, test_vm_ip, value) -%}
  {{ render_record_table(title, [
    {'label': 'Test VM IP', 'value': test_vm_ip, 'mono': true},
    {'label': 'DNS Result', 'value': value | replace('"', ''), 'mono': true}
  ]) }}
{%- endmacro %}

{% macro render_special_value(check_name, value) -%}
  {%- if check_name == 'Status of the registered KVM hosts' and value is sequence and value is not string -%}
    {{ render_kvm_hosts_table(value) }}
  {%- elif check_name == 'Datastores list' and value is sequence and value is not string -%}
    {{ render_simple_list_table(value, 'Datastore') }}
  {%- elif check_name == 'Registered marketplaces' and value is sequence and value is not string -%}
    {{ render_simple_list_table(value, 'Marketplace') }}
  {%- else -%}
    {{ render_value(value) }}
  {%- endif -%}
{%- endmacro %}

{% macro render_config_diff_comment(comment) -%}
  <pre class="mini-pre">{{ {
    'status': comment.status | default(''),
    'reference_host': comment.reference_host | default(''),
    'exclude_patterns': comment.exclude_patterns | default([])
  } | to_nice_json(indent=2) }}</pre>
  {%- set differences = comment.differences | default({}) -%}
  {%- if differences | length > 0 -%}
    {%- for host, files in differences.items() %}
      {%- for file_path, diff in files.items() %}
  <details class="mini-pre">
    <summary>{{ host }} :: {{ file_path }} — {{ diff.status | default('differs') }}</summary>
    <pre>{{ {
      'reference_present': diff.reference_present | default(false),
      'host_present': diff.host_present | default(false),
      'reference_line_count': diff.reference_line_count | default(0),
      'host_line_count': diff.host_line_count | default(0),
      'reference_sha256': diff.reference_sha256 | default(''),
      'host_sha256': diff.host_sha256 | default(''),
      'reference_only_lines': diff.reference_only_lines | default([]),
      'host_only_lines': diff.host_only_lines | default([])
    } | to_nice_json(indent=2) }}</pre>
  </details>
      {%- endfor %}
    {%- endfor %}
  {%- endif -%}
{%- endmacro %}

{% macro render_comment(comment) -%}
  {%- if comment is mapping and comment.differences is defined -%}
{{ render_config_diff_comment(comment) }}
  {%- elif comment is mapping or (comment is sequence and comment is not string) -%}
<pre class="mini-pre">{{ comment | to_nice_json(indent=2) }}</pre>
  {%- else -%}
{{ comment }}
  {%- endif -%}
{%- endmacro %}

{% macro render_check_table(items, section_title, table_id) -%}
  {%- if items | length > 0 -%}
  <section class="rst-section">
    <button class="rst-header" type="button" onclick="toggleTable('table-{{ table_id }}', 'tog-{{ table_id }}')">
      <h3>{{ section_title }} ({{ items | length }} checks)</h3><span class="tog" id="tog-{{ table_id }}">v</span>
    </button>
    <table class="rtable" id="table-{{ table_id }}"><tbody>
      {%- for k, v in items %}
      {%- set raw_comment = (verification_comments | default({})).get(k, '') %}
      {%- set comment_text = (raw_comment | to_nice_json(indent=2)) if raw_comment is mapping or (raw_comment is sequence and raw_comment is not string) else (raw_comment | string | trim) %}
      {%- set status = status_from(v, comment_text) | trim %}
      <tr><td class="status-cell">{{ badge(status) }}</td><td><div class="cn">{{ k }}</div>{{ render_special_value(k, v) }}{% if comment_text != '' %}<div class="comment"><span class="comment-lbl">NOTE</span>{{ render_comment(raw_comment) }}</div>{% endif %}</td></tr>
      {%- endfor %}
    </tbody></table>
  </section>
  {%- endif -%}
{%- endmacro %}

{% set checks = verification_result | default({}) %}
{% set comments = verification_comments | default({}) %}
{% set counts = namespace(pass=0, fail=0, warn=0, info=0) %}
{% for k, v in checks.items() %}
  {% set status = status_from(v, comments.get(k, '')) | trim %}
  {% if status == 'pass' %}{% set counts.pass = counts.pass + 1 %}{% elif status == 'fail' %}{% set counts.fail = counts.fail + 1 %}{% elif status == 'warn' %}{% set counts.warn = counts.warn + 1 %}{% else %}{% set counts.info = counts.info + 1 %}{% endif %}
{% endfor %}
{% if validation_vars.networks_verification | default(false) and network_verification_results is defined %}
  {% for net_name, net_results in network_verification_results.items() %}
    {% set status = status_from(net_results) | trim %}
    {% if status == 'pass' %}{% set counts.pass = counts.pass + 1 %}{% elif status == 'fail' %}{% set counts.fail = counts.fail + 1 %}{% elif status == 'warn' %}{% set counts.warn = counts.warn + 1 %}{% else %}{% set counts.info = counts.info + 1 %}{% endif %}
  {% endfor %}
{% endif %}
{% if validation_vars.run_conn_matrix | default(false) %}
  {% set cm = conn_results_matrix | default({}) %}
  {% set cm_ns = namespace(status=('pass' if cm | length > 0 else 'fail')) %}
  {% set cm_hosts = cm.keys() | list %}
  {% for src in cm_hosts %}
    {% for dst in cm_hosts %}
      {% if src != dst %}
        {% set result_element = (cm[src] | dict2items | selectattr('key', 'search', dst + '.json$') | map(attribute='value') | list) %}
        {% if result_element | length != 1 %}
          {% if cm_ns.status != 'fail' %}{% set cm_ns.status = 'warn' %}{% endif %}
        {% else %}
          {% set result = result_element | first %}
          {% if result.packet_loss_percent is not defined or result.packet_loss_percent | float != 0.0 %}
            {% set cm_ns.status = 'fail' %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  {% if cm_ns.status == 'pass' %}{% set counts.pass = counts.pass + 1 %}{% elif cm_ns.status == 'fail' %}{% set counts.fail = counts.fail + 1 %}{% else %}{% set counts.warn = counts.warn + 1 %}{% endif %}
{% endif %}
{% set total = counts.pass + counts.fail + counts.warn %}
{% set readiness_total = counts.pass + counts.fail + counts.warn %}
{% set pct = ((counts.pass * 100 / readiness_total) | round(0, 'common')) | int if readiness_total > 0 else 0 %}
{% set overall_status = 'fail' if counts.fail > 0 else ('warn' if counts.warn > 0 else 'pass') %}
{% set arch = template_report_architecture | default({}) %}
{% set arch_frontends = arch.frontends | default([]) %}
{% set arch_hypervisors = arch.hypervisors | default([]) %}
{% set report_title = 'Cloud Verification Report' %}
{% set report_task = 'Verification of an OpenNebula Cloud deployment' %}
{% set report_customer_name = template_report_customer | default('N/A') %}
{% set report_version_label = template_report_document_version | default(repo_version, true) %}
{% set report_abstract_text = template_report_abstract | default('', true) | trim %}
{% if report_abstract_text == '' %}{% set report_abstract_text = template_report_default_abstract %}{% endif %}
{% set report_revision_version_label = template_report_revision_version | default('', true) | trim %}
{% if report_revision_version_label == '' %}{% set report_revision_version_label = report_version_label %}{% endif %}
{% set report_revision_comment_text = template_report_revision_comment | default('', true) | trim %}
{% if report_revision_comment_text == '' %}{% set report_revision_comment_text = 'Verification actions successful' %}{% endif %}
{% set oned_version_text = checks.get('Oned version', arch.oned_version | default('', true)) | string %}
{% if oned_version_text | trim == '' %}{% set oned_version_text = 'N/A' %}{% endif %}
{% set oned_version_match = oned_version_text | regex_search('([0-9]+\\.[0-9]+\\.[0-9]+)') %}
{% set deployment_opennebula_version = oned_version_match if oned_version_match else oned_version_text %}
{% set deployment_zone_count = arch.zone_count | default(1) | int %}
{% set deployment_frontend_count = arch.frontend_count | default(arch_frontends | length) | int %}
{% set deployment_hypervisor_count = arch.hypervisor_count | default(arch_hypervisors | length) | int %}
{% set hypervisor_role_name = 'KVM' %}
{% set deployment_hypervisor_label = deployment_hypervisor_count ~ ' ' ~ hypervisor_role_name ~ (' hypervisor' if deployment_hypervisor_count == 1 else ' hypervisors') %}
{% set deployment_federation = 'Multi-zone' if deployment_zone_count > 1 else 'Single Zone' %}
{% set deployment_ha = 'Yes' if deployment_frontend_count > 1 else 'No' %}
{% set deployment_networking = 'Not included in target architecture' %}
{% set datastores_value = checks.get('Datastores list', arch.datastore_names | default([])) %}
{% if datastores_value is sequence and datastores_value is not string %}
  {% set deployment_storage = datastores_value | join(', ') %}
{% else %}
  {% set deployment_storage = datastores_value | default('Not discovered') %}
{% endif %}
{% if deployment_storage | trim == '' %}{% set deployment_storage = 'Not discovered' %}{% endif %}
{% set deployment_other_components = 'None detected' %}
{% set deployment_applications = 'OpenNebula command line tool' %}

{% set ns = namespace(core_services=[], vm_tests=[], ldap=[], oneflow=[], vm_ha=[], fe_ha=[], federation=[], other=[]) %}
{% for k, v in checks.items() %}
  {% set kl = k | lower %}
  {% if 'oneflow' in kl %}{% set _ = ns.oneflow.append((k, v)) %}
  {% elif 'ldap' in kl or 'rpc2' in kl %}{% set _ = ns.ldap.append((k, v)) %}
  {% elif 'service' in kl or 'xml-rpc' in kl or 'oned version' in kl or 'repository' in kl or 'datastore' in kl or 'marketplace' in kl or 'registered kvm' in kl or 'hosts status' in kl %}{% set _ = ns.core_services.append((k, v)) %}
  {% elif 'test vm' in kl or ('storage' in kl and 'benchmark' not in kl) or 'template' in kl %}{% set _ = ns.vm_tests.append((k, v)) %}
  {% elif 'vm ha' in kl or 'fencing' in kl or 'host error' in kl %}{% set _ = ns.vm_ha.append((k, v)) %}
  {% elif 'fe ha' in kl or 'leader' in kl or 'vip' in kl or 'config diretory' in kl %}{% set _ = ns.fe_ha.append((k, v)) %}
  {% elif 'federation' in kl %}{% set _ = ns.federation.append((k, v)) %}
  {% else %}{% set _ = ns.other.append((k, v)) %}
  {% endif %}
{% endfor %}

<div class="wrap">
  <section class="doc-page page-break">
    <div class="doc-topline">
      <div class="doc-brand">{% include '_report_logo_fragment.html' %}</div>
      <div class="doc-confidential">CONFIDENTIAL-NOT FOR DISTRIBUTION</div>
    </div>
    <h1 class="cover-title">{{ report_title }}</h1>
    <table class="cover-meta">
      <tbody>
        <tr><th>Task</th><td>{{ report_task }}</td></tr>
        <tr><th>Customer</th><td>{{ report_customer_name }}</td></tr>
        <tr><th>Date</th><td>{{ report_date_only }}</td></tr>
        <tr><th>Version</th><td>{{ report_version_label }}</td></tr>
      </tbody>
    </table>
    <div class="section-title" style="margin-bottom:8px">Abstract</div>
    <div class="cover-abstract">{{ report_abstract_text }}</div>
    <div class="section-title" style="margin-bottom:8px">Revision History</div>
    <table class="subtable">
      <thead>
        <tr><th>Version</th><th>Date</th><th>Author</th><th>Comments</th></tr>
      </thead>
      <tbody>
        <tr>
          <td class="mono">{{ report_revision_version_label }}</td>
          <td class="mono">{{ report_date_only }}</td>
          <td>OpenNebula Systems</td>
          <td>{{ report_revision_comment_text }}</td>
        </tr>
      </tbody>
    </table>
    <div class="section-title" style="margin-top:24px;margin-bottom:10px">1. Introduction</div>
    <p class="cover-abstract">The following table summarizes the main characteristics of the cloud that will be verified under this service contract.</p>
    <table class="summary-table">
      <tbody>
        <tr><th>OpenNebula Version</th><td>{{ deployment_opennebula_version }}</td></tr>
        <tr><th>Federation</th><td>{{ deployment_federation }}</td></tr>
        <tr><th>High Availability</th><td>{{ deployment_ha }}</td></tr>
        <tr><th>Front-ends</th><td>{{ deployment_frontend_count }}</td></tr>
        <tr><th>Hypervisors</th><td>{{ deployment_hypervisor_label }}</td></tr>
        <tr><th>Networking</th><td>{{ deployment_networking }}</td></tr>
        <tr><th>Storage</th><td>{{ deployment_storage }}</td></tr>
        <tr><th>Other Components</th><td>{{ deployment_other_components }}</td></tr>
        <tr><th>Applications</th><td>{{ deployment_applications }}</td></tr>
      </tbody>
    </table>
  </section>

  <section class="doc-page page-break">
    <div class="doc-topline">
      <div class="doc-brand">{% include '_report_logo_fragment.html' %}</div>
      <div class="doc-confidential">CONFIDENTIAL-NOT FOR DISTRIBUTION</div>
    </div>
    <div class="section-title" style="margin-bottom:10px">Table of Contents</div>
    <ol class="toc-list">
      <li><span class="toc-label">1. Introduction</span><span class="toc-page">1</span></li>
      <li><span class="toc-label">2. Automated validation of the OpenNebula services</span><span class="toc-page">3</span></li>
      {% if validation_vars.networks_verification | default(false) and network_verification_results is defined and network_verification_results | length > 0 %}
      <li><span class="toc-label">3. Virtual Networks automated validation results</span><span class="toc-page">5</span></li>
      {% endif %}
      {% if validation_vars.run_storage_benchmark | default(false) or validation_vars.run_network_benchmark | default(false) %}
      <li><span class="toc-label">4. Benchmarking of the OpenNebula infrastructure</span><span class="toc-page">later</span></li>
      {% endif %}
      <li><span class="toc-label">5. Variables used for validation</span><span class="toc-page">final</span></li>
    </ol>
  </section>

  <div class="header">
    <div class="header-logo"><a href="https://opennebula.io" target="_blank" rel="noopener">{% include '_report_logo_fragment.html' %}</a></div><div class="header-div"></div>
    <div class="hm"><h1>Automated Cloud Verification Report</h1><p>Generated: <strong>{{ date }}</strong> &nbsp;.&nbsp; Repository version: <strong>{{ repo_version }}</strong></p><p>{{ arch.summary | default('OpenNebula installation verification results, network validation, benchmark data, and validation variables.') | safe }}</p></div>
    <div class="header-meta"><span class="role-pill">Cloud Verification</span><span class="ts">{{ date }}</span></div>
  </div>

  <div class="banner status-{{ overall_status }}"><span>{% if overall_status == 'fail' %}NOT READY - FIX FAILURES FIRST{% elif overall_status == 'warn' %}READY WITH WARNINGS - REVIEW NOTES{% else %}READY - ALL CHECKS PASSED{% endif %}</span></div>
  <div class="cards"><div class="card cp"><div class="num">{{ counts.pass }}</div><div class="lbl">Passed</div></div><div class="card cf"><div class="num">{{ counts.fail }}</div><div class="lbl">Failed</div></div><div class="card cw"><div class="num">{{ counts.warn }}</div><div class="lbl">Warnings</div></div><div class="card ct"><div class="num">{{ total }}</div><div class="lbl">Total</div></div></div>
  <div class="pgwrap"><div class="pglbl"><span>Overall Readiness</span><span id="pct-lbl">{{ pct }}% passing</span></div><div class="pgbar"><div class="pgfill" id="pgfill" style="width:{{ pct }}%"></div></div></div>

  {% if arch_frontends | length > 0 or arch_hypervisors | length > 0 %}
  <div class="arch-section">
    <div class="section-title">Target Architecture</div>

    <div class="subblock">
      <div class="section-title" style="margin:12px 0 8px">Frontends</div>
      <div class="table-scroll">
        <table class="gtable">
          <thead><tr><th>Inventory Host</th><th>Address</th></tr></thead>
          <tbody>
          {% for frontend in arch_frontends %}
            <tr>
              <td class="mono">{{ frontend.inventory_name | default('') }}</td>
              <td class="mono">{{ frontend.ansible_host | default('') }}</td>
            </tr>
          {% else %}
            <tr><td colspan="2">No frontends defined in the inventory.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="subblock">
      <div class="section-title" style="margin:16px 0 8px">Hypervisors</div>
      <div class="table-scroll">
        <table class="gtable">
          <thead><tr><th>Inventory Host</th><th>Address</th></tr></thead>
          <tbody>
          {% for hypervisor in arch_hypervisors %}
            <tr>
              <td class="mono">{{ hypervisor.inventory_name | default('') }}</td>
              <td class="mono">{{ hypervisor.ansible_host | default('') }}</td>
            </tr>
          {% else %}
            <tr><td colspan="2">No hypervisors defined in the inventory.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {{ render_check_table(ns.core_services, "Core Services", "core") }}
  {{ render_check_table(ns.vm_tests, "VM Instantiation Tests", "vm") }}
  {{ render_check_table(ns.oneflow, "OneFlow Smoke Test", "oneflow") }}
  {{ render_check_table(ns.ldap, "LDAP Authentication", "ldap") }}
  {{ render_check_table(ns.vm_ha, "VM High Availability", "vmha") }}
  {{ render_check_table(ns.fe_ha, "Frontend High Availability", "feha") }}
  {{ render_check_table(ns.federation, "Federation Configuration", "federation") }}
  {{ render_check_table(ns.other, "Other Checks", "other") }}

  {% if all_federation_results is defined and all_federation_results | length > 0 %}
  {% set ns_fed = namespace(normalized_checks={}) %}
  {% for host, results in all_federation_results.items() %}{% for check, value in results.items() %}{% set base_check = check | regex_replace(' on [^\\s]+$', '') %}{% if base_check not in ns_fed.normalized_checks %}{% set _ = ns_fed.normalized_checks.update({base_check: {}}) %}{% endif %}{% set _ = ns_fed.normalized_checks[base_check].update({host: value}) %}{% endfor %}{% endfor %}
  {% set fed_hosts = all_federation_results.keys() | list %}
  <section class="data-section"><div class="section-title">Federation Detailed Results (All Zones)</div><div class="table-scroll"><table class="gtable"><thead><tr><th>Check</th>{% for host in fed_hosts %}<th>{{ host }}</th>{% endfor %}</tr></thead><tbody>{% for check, host_values in ns_fed.normalized_checks.items() %}<tr><td>{{ check }}</td>{% for host in fed_hosts %}{% set result = host_values.get(host, 'N/A') %}{% set status = status_from(result) | trim %}<td>{{ badge(status) }} {{ result }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div></section>
  {% endif %}

  {% if validation_vars.networks_verification | default(false) and network_verification_results is defined and network_verification_results | length > 0 %}
  <section class="rst-section">
    <button class="rst-header" type="button" onclick="toggleTable('table-networks', 'tog-networks')"><h3>Virtual Networks Validation ({{ network_verification_results | length }} networks)</h3><span class="tog" id="tog-networks">v</span></button>
    <table class="rtable" id="table-networks"><tbody>
    {% for network_name, results in network_verification_results.items() %}
      {% set status = status_from(results) | trim %}
      <tr>
        <td class="status-cell">{{ badge(status) }}</td>
        <td>
          <div class="cn">{{ network_name }}</div>
          {% set test_vm_ip = results.get('Test VM IP', 'N/A') %}
          {% set gw_ping_raw = results.get('Network GW ping', results.get('\nNetwork GW ping, packet received', results.get('Network GW ping, packet received'))) %}
          {% set ext_ping_raw = results.get('External Host ping', results.get('\nExternal Host ping: ', results.get('External Host ping: ', results.get('\nExternal Host ping::', results.get('External Host ping::'))))) %}
          {% set gw_ping = (gw_ping_raw | from_json) if gw_ping_raw is string and (gw_ping_raw | trim | regex_search('^\\{')) else gw_ping_raw %}
          {% set ext_ping = (ext_ping_raw | from_json) if ext_ping_raw is string and (ext_ping_raw | trim | regex_search('^\\{')) else ext_ping_raw %}
          {% set dns_result = results.get('External host DNS resolution', results.get('\nExternal host DNS resolvation', results.get('External host DNS resolvation'))) %}
          {{ render_record_table('Validation Summary', [
            {'label': 'Test VM IP', 'value': test_vm_ip, 'mono': true},
            {'label': 'Gateway Check', 'value': 'Available' if gw_ping is mapping else 'Not available'},
            {'label': 'External Ping Check', 'value': 'Available' if ext_ping is mapping else 'Not available'},
            {'label': 'External DNS Resolution', 'value': dns_result | default('Not available') | replace('"', '')}
          ]) }}
          {% if gw_ping is mapping %}{{ render_ping_record_table('Network GW ping details', test_vm_ip, gw_ping) }}{% endif %}
          {% if ext_ping is mapping %}{{ render_ping_record_table('External Host ping details', test_vm_ip, ext_ping) }}{% endif %}
          {% if dns_result is defined and dns_result is not none %}{{ render_dns_record_table('External host DNS resolution', test_vm_ip, dns_result) }}{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody></table>
  </section>
  {% endif %}

  {% if validation_vars.run_storage_benchmark | default(false) and storage_benchmark is defined and storage_benchmark | length > 0 %}
  <section class="data-section"><div class="section-title">Storage Benchmarking Results</div>
  {% set ordered_profiles = [{'key':'rr_4k_qd1','label':'rr_4k_qd1'},{'key':'rr_4k_qd4','label':'rr_4k_qd4'},{'key':'rr_4k_qd16','label':'rr_4k_qd16'},{'key':'rr_4k_qd32','label':'rr_4k_qd32'},{'key':'rr_4k_qd64','label':'rr_4k_qd64'},{'key':'rw_4k_qd1','label':'rw_4k_qd1'},{'key':'rw_4k_qd4','label':'rw_4k_qd4'},{'key':'rw_4k_qd16','label':'rw_4k_qd16'},{'key':'rw_4k_qd32','label':'rw_4k_qd32'},{'key':'rw_4k_qd64','label':'rw_4k_qd64'},{'key':'mix_4k_70r_qd16','label':'mix_4k_70r_qd16'},{'key':'mix_64k_70r_qd16','label':'mix_64k_70r_qd16'},{'key':'seqr_128k_qd16','label':'seqr_128k_qd16'},{'key':'seqw_128k_qd16','label':'seqw_128k_qd16'},{'key':'seqr_1m_qd4','label':'seqr_1m_qd4'},{'key':'seqw_1m_qd4','label':'seqw_1m_qd4'},{'key':'syncwrite_4k_qd1','label':'syncwrite_4k_qd1'}] %}
  {% for host in storage_benchmark.keys() | list %}<div class="section-title" style="margin-top:14px">{{ host }}</div><div class="table-scroll"><table class="gtable"><thead><tr><th>Job</th><th class="num">IOPS</th><th class="num">BW (MB/s)</th><th class="num">p99 Lat (ms)</th><th class="num">Score</th></tr></thead><tbody>
  {% for item in ordered_profiles %}{% set p = (storage_benchmark[host].profiles | default([]) | selectattr('name','equalto',item.key) | list | first | default({})) %}{% set rw = p.rw | default('') %}{% if rw in ['read','randread'] %}{% set iops = p.read_iops | default(None) %}{% set bw_kib = p.read_bw_kib | default(None) %}{% set lat_ns = p.read_p99_ns | default(None) %}{% elif rw in ['write','randwrite'] %}{% set iops = p.write_iops | default(None) %}{% set bw_kib = p.write_bw_kib | default(None) %}{% set lat_ns = p.write_p99_ns | default(None) %}{% elif rw in ['rw','randrw'] %}{% set iops = (p.read_iops | default(0)) + (p.write_iops | default(0)) %}{% set bw_kib = (p.read_bw_kib | default(0)) + (p.write_bw_kib | default(0)) %}{% set lat_ns = [p.read_p99_ns | default(0), p.write_p99_ns | default(0)] | max %}{% else %}{% set iops = None %}{% set bw_kib = None %}{% set lat_ns = None %}{% endif %}{% set bw_mbs = (bw_kib / 1024) if bw_kib is not none else None %}{% set lat_ms = (lat_ns / 1000000) if lat_ns is not none else None %}{% if item.key[:3] == 'seq' %}{% set score = '★★★' if bw_mbs is not none and bw_mbs >= 300 else ('★★' if bw_mbs is not none and bw_mbs >= 150 else ('★' if bw_mbs is not none and bw_mbs >= 75 else '⚠')) %}{% else %}{% set score = '★★★' if lat_ms is not none and lat_ms <= 5 else ('★★' if lat_ms is not none and lat_ms <= 10 else ('★' if lat_ms is not none and lat_ms <= 20 else '⚠')) %}{% endif %}<tr><td>{{ item.label }}</td><td class="num">{{ iops | default('N/A') }}</td><td class="num">{% if bw_mbs is not none %}{{ bw_mbs | round(2) }}{% else %}N/A{% endif %}</td><td class="num">{% if lat_ms is not none %}{{ lat_ms | round(2) }}{% else %}N/A{% endif %}</td><td class="score-cell">{{ score }}</td></tr>{% endfor %}
  </tbody></table></div>{% endfor %}</section>
  {% endif %}

  {% if validation_vars.run_gpu_benchmark | default(false) and gpu_benchmark_results is defined and gpu_benchmark_results | length > 0 %}
  {# Charts are hand-rolled inline SVG on purpose: the report is also rendered
     to PDF by weasyprint, which executes NO JavaScript — charting libraries
     would silently vanish from the PDF. #}
  {% macro line_chart(title, series, x_label, y_label, hline=0, hline_label='') %}
  {% set W, H = 560, 230 %}{% set pl, pr, ptop, pb = 56, 16, 14, 38 %}
  {% set iw, ih = W - pl - pr, H - ptop - pb %}
  {% set allp = [] %}{% for s in series %}{% for p in s.points %}{% if allp.append(p) %}{% endif %}{% endfor %}{% endfor %}
  {% set xmax = allp | map(attribute='x') | max | float %}
  {% set ymax0 = allp | map(attribute='y') | max | float %}
  {% set ymax0 = ([ymax0, hline | float] | max) if (hline | float) > 0 else ymax0 %}
  {% set ymax = ymax0 * 1.08 %}
  {% if xmax > 0 and ymax > 0 %}
  <div class="chart-card">
  <div class="chart-title">{{ title }}</div>
  <div class="chart-legend">{% for s in series %}<span><span class="sw" style="background:{{ s.color }}"></span>{{ s.label }}</span>{% endfor %}{% if (hline | float) > 0 %}<span><span class="sw" style="background:#fff;border:1px dashed #b91c1c"></span>{{ hline_label }}</span>{% endif %}</div>
  <svg viewBox="0 0 {{ W }} {{ H }}" style="width:100%;height:auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ title }}">
  {% for i in range(5) %}{% set fy = ptop + ih * i / 4 %}{% set vy = ymax * (4 - i) / 4 %}<line x1="{{ pl }}" y1="{{ fy | round(1) }}" x2="{{ W - pr }}" y2="{{ fy | round(1) }}" stroke="#e2e8f0" stroke-width="1"/><text x="{{ pl - 6 }}" y="{{ (fy + 3.5) | round(1) }}" text-anchor="end" font-size="10" fill="#64748b" font-family="IBM Plex Mono,monospace">{{ vy | round(0) | int }}</text>{% endfor %}
  {% for i in range(5) %}{% set fx = pl + iw * i / 4 %}<text x="{{ fx | round(1) }}" y="{{ H - pb + 16 }}" text-anchor="middle" font-size="10" fill="#64748b" font-family="IBM Plex Mono,monospace">{{ (xmax * i / 4) | round(1) }}</text>{% endfor %}
  <line x1="{{ pl }}" y1="{{ ptop }}" x2="{{ pl }}" y2="{{ H - pb }}" stroke="#94a3b8" stroke-width="1"/>
  <line x1="{{ pl }}" y1="{{ H - pb }}" x2="{{ W - pr }}" y2="{{ H - pb }}" stroke="#94a3b8" stroke-width="1"/>
  <text x="{{ pl + iw // 2 }}" y="{{ H - 4 }}" text-anchor="middle" font-size="10" fill="#64748b">{{ x_label }}</text>
  <text x="12" y="{{ ptop + ih // 2 }}" text-anchor="middle" font-size="10" fill="#64748b" transform="rotate(-90 12 {{ ptop + ih // 2 }})">{{ y_label }}</text>
  {% if (hline | float) > 0 and (hline | float) <= ymax %}{% set hy = ptop + ih * (1 - (hline | float) / ymax) %}<line x1="{{ pl }}" y1="{{ hy | round(1) }}" x2="{{ W - pr }}" y2="{{ hy | round(1) }}" stroke="#b91c1c" stroke-width="1" stroke-dasharray="5,4"/>{% endif %}
  {% for s in series %}{% set ns = namespace(pts='') %}{% for p in s.points %}{% set ns.pts = ns.pts ~ ((pl + iw * (p.x / xmax)) | round(1)) ~ ',' ~ ((ptop + ih * (1 - p.y / ymax)) | round(1)) ~ ' ' %}{% endfor %}<polyline points="{{ ns.pts | trim }}" fill="none" stroke="{{ s.color }}" stroke-width="2"/>{% for p in s.points %}<circle cx="{{ (pl + iw * (p.x / xmax)) | round(1) }}" cy="{{ (ptop + ih * (1 - p.y / ymax)) | round(1) }}" r="3" fill="{{ s.color }}"/>{% endfor %}{% endfor %}
  </svg>
  </div>
  {% endif %}
  {% endmacro %}
  {% macro bar_chart(title, bars, unit='') %}
  {# Label gutter sized to the LONGEST label (11px monospace ~ 7px/char):
     a fixed gutter clips long labels off the viewBox left edge. #}
  {% set W = 560 %}{% set rh = 26 %}{% set pr = 100 %}
  {% set pl = [64, ((bars | map(attribute='label') | map('length') | max) * 7 + 12)] | max %}
  {% set H = bars | length * rh + 10 %}
  {% set vmax = bars | map(attribute='value') | max | float %}
  {% if vmax > 0 %}
  <div class="chart-card">
  <div class="chart-title">{{ title }}</div>
  <svg viewBox="0 0 {{ W }} {{ H }}" style="width:100%;height:auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ title }}">
  {% for b in bars %}{% set y = 5 + loop.index0 * rh %}{% set bw = (W - pl - pr) * (b.value / vmax) %}<text x="{{ pl - 8 }}" y="{{ y + 13 }}" text-anchor="end" font-size="11" fill="#0f172a" font-family="IBM Plex Mono,monospace">{{ b.label }}</text><rect x="{{ pl }}" y="{{ y }}" width="{{ bw | round(1) }}" height="{{ rh - 8 }}" rx="3" fill="{{ b.color }}"/><text x="{{ (pl + bw + 6) | round(1) }}" y="{{ y + 13 }}" font-size="11" fill="#64748b" font-family="IBM Plex Mono,monospace">{{ b.value | round(0) | int }}{{ unit }}</text>{% endfor %}
  </svg>
  </div>
  {% endif %}
  {% endmacro %}
  {% set gpu_colors = ['#1a7ba4', '#7c3aed', '#15803d', '#b45309', '#b91c1c', '#0e7490', '#9333ea', '#065f46'] %}
  <section class="data-section"><div class="section-title">GPU / LLM Benchmark Results</div>
  {% for host, data in gpu_benchmark_results.items() %}
  <div class="section-title" style="margin-top:14px">{{ host }} — status: {{ data.status | default('n/a') }}{% if data.note | default('') %} ({{ data.note }}){% endif %}</div>
  {% if data.error | default('') | string | length > 0 %}<div class="mini-pre">Error: {{ data.error | e }}</div>{% endif %}
  {% set _all_smi = (data.gpu_health | default({})).hosts | default([]) | selectattr('nvidia_smi', 'defined') | map(attribute='nvidia_smi') | flatten | list %}
  {% set _vrams = _all_smi | map(attribute='vram_mib') | map('string') | select('ne', '') | unique | list %}
  {% if _all_smi | length > 0 %}<div class="mini-pre">Platform: {{ _all_smi | length }}&times; {{ _all_smi | map(attribute='name') | unique | join(' / ') }}{% if _vrams | length == 1 %} ({{ ((_vrams[0] | int) / 1024) | round(0) | int }} GiB VRAM each){% endif %}{% if data.meta.driver_version | default('') %} — driver {{ data.meta.driver_version }}{% endif %}{% if data.meta.cuda_version | default('') %}, CUDA {{ data.meta.cuda_version }}{% endif %}</div>{% endif %}
  {% if (data.meta | default({})).phase | default('post') == 'pre' %}<div class="mini-pre"><strong>Bare-metal pre-deploy baseline</strong> — executed directly on the host OS (no OpenNebula, no virtualization). These results are saved as the reference the post-deploy run is compared against.</div>{% endif %}
  {% if data.meta is defined and data.meta %}<div class="mini-pre">Run: {{ data.meta.timestamp | default('') }}{% if (data.meta.phase | default('post')) != 'pre' %} — appliance template ID {{ data.meta.appliance_template_id | default('n/a', true) }}{% endif %} — model(s): {{ data.meta.models | default([]) | join(', ') }}</div>{% endif %}
  {% set _kpi_tok = [] %}{% set _kpi_ttft = [] %}{% set _kpi_gf = [] %}
  {% for lk, lm in (data.llm | default({})).items() %}{% for g in lm.per_gpu | default([]) %}{% if g.metrics is defined %}{% if (g.metrics.output_tok_s_saturated | default('') | string | length) > 0 %}{% if _kpi_tok.append(g.metrics.output_tok_s_saturated | float) %}{% endif %}{% endif %}{% if _kpi_ttft.append(g.metrics.ttft_p95_ms | float) %}{% endif %}{% endif %}{% endfor %}{% endfor %}
  {% for h in (data.gpu_health | default({})).hosts | default([]) %}{% if h.cublas is defined and h.cublas.skipped is not defined %}{% for c in h.cublas %}{% if _kpi_gf.append(c.gflops | float) %}{% endif %}{% endfor %}{% endif %}{% endfor %}
  {% if (_kpi_gf | length > 0) or (_kpi_tok | length > 0) %}
  <div class="cards" style="margin-top:14px;margin-bottom:10px">
    <div class="card {{ 'cp' if (data.status | default('')) == 'ok' else 'cw' }}"><span class="num">{{ _all_smi | length }}</span><span class="lbl">GPUs tested</span></div>
    {% if _kpi_gf | length > 0 %}<div class="card ct"><span class="num">{{ ((_kpi_gf | max) / 1000) | round(1) }}k</span><span class="lbl">cuBLAS GFLOP/s (best)</span></div>{% endif %}
    {% if _kpi_tok | length > 0 %}<div class="card ct"><span class="num">{{ _kpi_tok | max | round(0) | int }}</span><span class="lbl">Output tokens/s (peak)</span></div>{% endif %}
    {% if _kpi_ttft | length > 0 %}<div class="card ct"><span class="num">{{ _kpi_ttft | min | round(0) | int }}</span><span class="lbl">Best TTFT p95 (ms, sync)</span></div>{% endif %}
  </div>
  {% endif %}
  {% for h in (data.gpu_health | default({})).hosts | default([]) %}
  <div class="section-title" style="margin-top:14px">Host {{ h.host_id }} — GPU inventory &amp; health{% if h.nvidia_issues | default([]) %} — issues: {{ h.nvidia_issues | join('; ') }}{% endif %}</div>
  <div class="table-scroll"><table class="gtable"><thead><tr><th>GPU</th><th>Name</th><th class="num">VRAM (MiB)</th><th class="num">Compute cap</th><th>VBIOS</th><th class="num">PCIe width</th><th class="num">PCIe GB/s (H2D/D2H)</th><th class="num">Power limit (W)</th><th class="num">Max SM clock (MHz)</th><th class="num">Temp (&deg;C)</th><th class="num">ECC errors</th><th class="num">cuBLAS GFLOP/s</th><th>Status</th></tr></thead><tbody>
  {% for g in h.nvidia_smi | default([]) %}{% set _pbl = h.pcie_bw | default([]) %}{% set _pb = (_pbl | selectattr('gpu', 'eq', (g.index | int)) | list | first | default({})) if (_pbl is not mapping) else {} %}<tr><td>{{ g.index }}</td><td>{{ g.name }}</td><td class="num">{{ g.vram_mib }}</td><td class="num">{{ g.compute_cap | default('—', true) }}</td><td>{{ g.vbios | default('—', true) }}</td><td class="num">x{{ g.pcie_width_current | default('?', true) }}/x{{ g.pcie_width_max | default('?', true) }}</td><td class="num">{% if _pb.h2d_gbs is defined %}{{ _pb.h2d_gbs | float | round(1) }}/{{ _pb.d2h_gbs | float | round(1) }}{% else %}—{% endif %}</td><td class="num">{% if g.power_limit_w | default('') %}{{ g.power_limit_w | float | round(0) | int }}{% else %}—{% endif %}</td><td class="num">{{ g.sm_clock_max_mhz | default('—', true) }}</td><td class="num">{{ g.temperature_c | default('—', true) }}</td><td class="num">{{ g.ecc_uncorrected | default('—', true) }}</td><td class="num">{% if h.cublas.skipped is defined %}skipped{% else %}{{ h.cublas | selectattr('gpu', 'eq', (g.index | int)) | map(attribute='gflops') | first | default('—') }}{% endif %}</td><td>{{ 'FLAG' if (g.index | int) in (h.flagged_gpus | default([]) | map('int') | list) else 'ok' }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% if h.dcgm is defined and h.dcgm %}<div class="mini-pre">NVIDIA DCGM diagnostics: {% if h.dcgm.status == 'pass' %}PASS ({{ h.dcgm.tests_total }} tests{% if h.dcgm.tests_skipped | default(0) | int > 0 %}, {{ h.dcgm.tests_skipped }} skipped{% endif %}){% if h.dcgm.warned | default([]) | length > 0 %}, warnings: {{ h.dcgm.warned | join(', ') }}{% endif %}{% elif h.dcgm.status == 'fail' %}FAIL — {{ h.dcgm.failed | default([]) | join(', ') }}{% else %}{{ h.dcgm.status }}{% if h.dcgm.detail | default('') %} ({{ h.dcgm.detail | e }}){% endif %}{% endif %}</div>{% endif %}
  {% set _cg = h.cublas | default([]) %}
  {% if h.cublas.skipped is not defined and (_cg | length) > 1 %}{% set _gf = _cg | map(attribute='gflops') | map('float') | list %}<div class="mini-pre">cuBLAS spread across {{ _gf | length }} GPUs: max {{ _gf | max | round(1) }} / min {{ _gf | min | round(1) }} GFLOP/s ({{ ((_gf | max - _gf | min) / (_gf | max) * 100) | round(1) }}% spread). Per-GPU pass/fail (incl. any cuBLAS/PCIe/DCGM issue) is in the Status column above.</div>
  {% set _cb_bars = [] %}{% for c in _cg %}{% if _cb_bars.append({'label': 'GPU ' ~ c.gpu, 'value': c.gflops | float, 'color': ('#b91c1c' if (c.gpu | int) in (h.flagged_gpus | default([]) | map('int') | list) else '#1a7ba4')}) %}{% endif %}{% endfor %}
  {{ bar_chart('cuBLAS SGEMM compute per GPU — host ' ~ h.host_id, _cb_bars, ' GFLOP/s') }}
  {% endif %}
  {% endfor %}
  {% if (data.llm | default({}) | length) > 0 and data.meta is defined %}
  <div class="mini-pre">Method: {{ data.meta.load_profile | default('GuideLLM sweep') }}. Each GPU is benchmarked individually (CUDA_VISIBLE_DEVICES pinning, tensor-parallel 1).{% set th = data.meta.thresholds | default({}) %}{% if th %} SLO profile '{{ th.profile | default('chat') }}': TTFT p95 {% if th.ttft_p95_ms is not none %}&le; {{ th.ttft_p95_ms }} ms{% else %}not gated{% endif %}, ITL p95 {% if th.itl_p95_ms is not none %}&le; {{ th.itl_p95_ms }} ms{% else %}not gated{% endif %} (synchronous run){% if th.min_throughput_req_s is defined and th.min_throughput_req_s is not none %}, throughput &ge; {{ th.min_throughput_req_s }} req/s (saturated run){% endif %}.{% endif %}{% if data.meta.reference | default({}) | length > 0 %} Hardware-calibrated reference SLOs override the profile where marked '(ref)':{% for rg, rmodels in data.meta.reference.items() %}{% for rm, rth in rmodels.items() %}{% set _has = (rth.ttft_p95_ms is defined and rth.ttft_p95_ms is not none) or (rth.itl_p95_ms is defined and rth.itl_p95_ms is not none) or (rth.min_throughput_req_s is defined and rth.min_throughput_req_s is not none) %} {{ rg }} / {{ rm }}:{% if not _has %} no numeric gate (calibration){% else %}{% if rth.ttft_p95_ms is defined and rth.ttft_p95_ms is not none %} TTFT p95 &le; {{ rth.ttft_p95_ms }} ms{% endif %}{% if rth.itl_p95_ms is defined and rth.itl_p95_ms is not none %}, ITL p95 &le; {{ rth.itl_p95_ms }} ms{% endif %}{% if rth.min_throughput_req_s is defined and rth.min_throughput_req_s is not none %}, throughput &ge; {{ rth.min_throughput_req_s }} req/s{% endif %}{% endif %}.{% endfor %}{% endfor %}{% endif %}</div>
  {% endif %}
  {% for lkey, m in (data.llm | default({})).items() %}
  {% set _okg = m.per_gpu | default([]) | selectattr('metrics', 'defined') | list %}
  <div class="section-title" style="margin-top:14px">{{ lkey }} — {{ m.status | default('n/a') }}</div>
  {% if (m.versions | default('')) or (m.provisioning_s | default('') | string | length > 0) %}<div class="mini-pre">{{ m.versions | default('') }}{% if m.provisioning_s | default('') | string | length > 0 %}{% if m.versions | default('') %} — {% endif %}provisioning: VM create &rarr; model serving in {{ m.provisioning_s }} s{% endif %}</div>{% endif %}
  {% if (m.per_gpu | default([]) | length) > 0 %}
  <div class="table-scroll"><table class="gtable"><thead><tr><th>GPU</th><th class="num">Output tok/s (sat)</th><th class="num">Sustained req/s (sat)</th><th class="num">Req latency p95 (s, sync)</th><th class="num">TTFT p95 (ms, sync)</th><th class="num">ITL p95 (ms, sync)</th><th class="num">TPOT p95 (ms, sync)</th><th class="num">TTFT p95 (ms, sat)</th><th>SLO</th></tr></thead><tbody>
  {% for g in m.per_gpu | default([]) %}{% if g.metrics is defined %}<tr><td>{{ g.gpu }}</td><td class="num">{% if g.metrics.output_tok_s_saturated | default('') | string | length > 0 %}{{ g.metrics.output_tok_s_saturated | float | round(0) | int }}{% else %}—{% endif %}</td><td class="num">{{ g.metrics.throughput_req_s_mean | float | round(2) }}</td><td class="num">{{ g.metrics.req_latency_p95_s | float | round(3) }}</td><td class="num">{{ g.metrics.ttft_p95_ms | float | round(1) }}</td><td class="num">{{ g.metrics.itl_p95_ms | float | round(2) }}</td><td class="num">{{ g.metrics.tpot_p95_ms | float | round(2) }}</td><td class="num">{% if (g.metrics.saturated | default({})).ttft_p95_ms is defined %}{{ g.metrics.saturated.ttft_p95_ms | float | round(1) }}{% else %}—{% endif %}</td><td>{% set _ev = g.evaluation | default({}) %}{% if _ev.gated is defined and not (_ev.gated | bool) %}not evaluated{% else %}{{ _ev.status | default('n/a') }}{% if (_ev.throughput_inconclusive | default(false) | string) == 'True' %}*{% endif %}{% if (_ev.source | default('global')) != 'global' %} (ref){% endif %}{% endif %}</td></tr>{% else %}<tr><td>{{ g.gpu }}</td><td colspan="8">Failed: {{ g.error | default('unknown error') | e }}</td></tr>{% endif %}{% endfor %}
  </tbody></table></div>
  {% set _unsat = _okg | selectattr('metrics.saturation_achieved', 'defined') | map(attribute='metrics.saturation_achieved') | map('string') | select('equalto', 'False') | list %}
  {% if _unsat | length > 0 %}<div class="mini-pre"><strong>Saturation not achieved:</strong> the concurrent throughput probe completed 0 requests within each rate window on {{ _unsat | length }} of {{ _okg | length }} GPU(s) — this GPU class is too slow for that load. The figures below are the PEAK single-stream rate reached, not a sustained ceiling the GPU can hold under concurrency.</div>
  {% elif _okg | length > 0 %}<div class="mini-pre">Sustained req/s = saturated token rate &divide; tokens-per-request (the steady-state request rate the GPU holds){% set _pk = (_okg | map(attribute='metrics.throughput_req_s_peak') | select('defined') | map('float') | list) %}{% if _pk | length > 0 %}; guidellm's short-window peak rate was up to {{ _pk | max | round(1) }} req/s (a drain burst, not sustainable){% endif %}. Headline throughput is output tokens/s, which is stable run-to-run.</div>{% endif %}
  {% set _tgpu = [] %}{% for g in _okg %}{% if (g.metrics.sweep_truncated | default(false) | string) == 'True' %}{% if _tgpu.append(g.gpu) %}{% endif %}{% endif %}{% endfor %}
  {# UNSATURATED = the slow-mode guidellm client under-measured the probe
     and the ladder stopped below the knee (server-side ITL identical in
     both modes) — same lower-bound treatment as a truncated sweep. #}
  {% set _ugpu = [] %}{% for g in _okg %}{% if ((g.metrics.sweep_unsaturated | default(false) | string) == 'True') and ((g.metrics.sweep_truncated | default(false) | string) != 'True') %}{% if _ugpu.append(g.gpu) %}{% endif %}{% endif %}{% endfor %}
  {% if _ugpu | length > 0 %}<div class="mini-pre"><strong>Sweep unsaturated on GPU {{ _ugpu | join(', GPU ') }}:</strong> the load generator landed in its slow client mode (a known bimodal behavior — the server-side token speed is identical in both modes) and under-measured the throughput probe, so the tested rate ladder stopped while the curve was still climbing — the peak/sustained figures for {{ 'this GPU are' if _ugpu | length == 1 else 'these GPUs are' }} a LOWER BOUND on capacity, not a measurement of it. Throughput gaps against {{ 'this GPU' if _ugpu | length == 1 else 'these GPUs' }} are treated as a measurement artifact, not flagged; an SLO verdict marked '*' means the throughput gate was inconclusive. Re-running redraws the probe and usually restores the full curve.</div>{% endif %}
  {% if _tgpu | length > 0 %}<div class="mini-pre"><strong>Sweep truncated on GPU {{ _tgpu | join(', GPU ') }}:</strong> guidellm derives its constant-rate ladder from a short throughput probe, and the probe under-measured (the overload region is chaotic) — the tested rates never reached the throughput knee, so the peak/sustained figures for {{ 'this GPU are' if _tgpu | length == 1 else 'these GPUs are' }} a LOWER BOUND on capacity, not a measurement of it. Throughput gaps against {{ 'this GPU' if _tgpu | length == 1 else 'these GPUs' }} are treated as a measurement artifact, not flagged; an SLO verdict marked '*' means the throughput gate was inconclusive (lower bound below the gate). Re-running the benchmark usually restores a full curve.</div>{% endif %}
  {% endif %}
  {% set _tok_series = [] %}{% set _ttft_series = [] %}
  {% for g in m.per_gpu | default([]) %}{% if (g.metrics | default({})).sweep is defined %}
  {% set _tp = [] %}{% set _lp = [] %}
  {% for r in g.metrics.sweep %}{% if (r.output_tok_s | string | length) > 0 %}{% if _tp.append({'x': r.rps | float, 'y': r.output_tok_s | float}) %}{% endif %}{% endif %}{% if _lp.append({'x': r.rps | float, 'y': r.ttft_p95_ms | float}) %}{% endif %}{% endfor %}
  {% set _col = gpu_colors[loop.index0 % 8] %}
  {% if _tp | length >= 2 %}{% if _tok_series.append({'label': 'GPU ' ~ g.gpu, 'color': _col, 'points': _tp | sort(attribute='x')}) %}{% endif %}{% endif %}
  {% if _lp | length >= 2 %}{% if _ttft_series.append({'label': 'GPU ' ~ g.gpu, 'color': _col, 'points': _lp | sort(attribute='x')}) %}{% endif %}{% endif %}
  {% endif %}{% endfor %}
  {% if (_tok_series | length > 0) or (_ttft_series | length > 0) %}
  {# SLO line = the gate that was ACTUALLY applied to this model's GPUs (per-GPU
     reference SLOs when resolved), not the global profile — the two can differ
     by an order of magnitude. Falls back to the globals for old data. #}
  {% set _ev0 = ((_okg | first | default({})).evaluation | default({})) %}
  {% set _slo = _ev0.thresholds | default((data.meta | default({})).thresholds | default({})) %}
  {% set _slo_ref = (_ev0.source | default('global')) != 'global' %}
  <div class="chart-row">
  {% if _tok_series | length > 0 %}{{ line_chart('Generation throughput vs achieved load', _tok_series, 'achieved requests/s', 'output tokens/s') }}{% endif %}
  {% if _ttft_series | length > 0 %}{{ line_chart('Time to first token (p95) vs achieved load', _ttft_series, 'achieved requests/s', 'TTFT p95 (ms)', (_slo.ttft_p95_ms | default(0, true)) | float, 'SLO ' ~ (_slo.ttft_p95_ms | default('', true)) ~ ' ms (sync gate' ~ (', ref' if _slo_ref else '') ~ ')') }}{% endif %}
  </div>
  {% endif %}
  {% for g in m.per_gpu | default([]) %}{% if (g.metrics | default({})).power is defined and g.metrics.power %}
  <div class="mini-pre">GPU {{ g.gpu }} under load: avg {{ g.metrics.power.power_avg_w }} W (max {{ g.metrics.power.power_max_w }} W), max temp {{ g.metrics.power.temp_max_c }} &deg;C, min SM clock {{ g.metrics.power.sm_clock_min_mhz }} MHz{% if g.metrics.tokens_per_watt | default('') | string | length > 0 %} — &asymp;{{ g.metrics.tokens_per_watt }} output tokens/s per watt (approximation: peak token rate &divide; run-average power over the whole sweep){% endif %}</div>
  {% endif %}{% endfor %}
  {% if m.functional is defined and m.functional and (m.functional.tests | default([]) | length > 0) %}
  <div class="section-title" style="margin-top:10px">API functional conformance — {{ 'ok' if (m.functional.status | default('ok')) == 'ok' else 'FLAG' }} ({{ m.functional.tests | selectattr('status', 'eq', 'pass') | list | length }}/{{ m.functional.tests | length }} passed)</div>
  <div class="table-scroll"><table class="gtable"><thead><tr><th>Test</th><th>Status</th><th>Detail</th></tr></thead><tbody>
  {% for t in m.functional.tests %}<tr><td>{{ t.name }}</td><td>{{ 'ok' if t.status == 'pass' else 'FAIL' }}</td><td>{{ (t.detail | default('') | e) if t.status != 'pass' else '—' }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% endif %}
  {% for g in m.per_gpu | default([]) %}{% if (g.metrics | default({})).sweep is defined and (g.metrics.sweep | length) > 0 %}
  <div class="section-title" style="margin-top:10px">GPU {{ g.gpu }} — load sweep ({{ g.metrics.sweep | length }} steps{% if g.metrics.requests_errored | default(0) | int > 0 %}, {{ g.metrics.requests_errored }} errored requests{% endif %})</div>
  <div class="table-scroll"><table class="gtable"><thead><tr><th>Strategy</th><th class="num">Target req/s</th><th class="num">Achieved req/s</th><th class="num">Output tok/s</th><th class="num">Avg concurrency</th><th class="num">TTFT p95 (ms)</th><th class="num">ITL p95 (ms)</th><th class="num">Requests (ok/incomplete/err)</th></tr></thead><tbody>
  {% for r in g.metrics.sweep %}<tr><td>{{ r.strategy }}</td><td class="num">{% if r.target_rate | string | length > 0 %}{{ r.target_rate | float | round(1) }}{% else %}—{% endif %}</td><td class="num">{{ r.rps }}</td><td class="num">{% if r.output_tok_s | string | length > 0 %}{{ r.output_tok_s | float | round(0) | int }}{% else %}—{% endif %}</td><td class="num">{% if r.concurrency | string | length > 0 %}{{ r.concurrency | float | round(1) }}{% else %}—{% endif %}</td><td class="num">{{ r.ttft_p95_ms }}</td><td class="num">{{ r.itl_p95_ms }}</td><td class="num">{% if r.requests_ok | string | length > 0 %}{{ r.requests_ok }}{% else %}—{% endif %}/{% if r.requests_incomplete | default('') | string | length > 0 %}{{ r.requests_incomplete }}{% else %}—{% endif %}/{% if r.requests_err | string | length > 0 %}{{ r.requests_err }}{% else %}—{% endif %}</td></tr>{% endfor %}
  </tbody></table></div>
  <div class="mini-pre">Incomplete = requests still in flight when the {{ (data.meta | default({})).rate_window_s | default(20) }} s rate window closed (expected under saturation); errored = failed requests.</div>
  {% endif %}{% endfor %}
  {% if m.delta is defined and m.delta and (m.delta.metrics | default([]) | length > 0) %}
  {% set _dlabels = {'throughput_req_s_mean': 'Throughput (req/s, sustained)', 'req_latency_p95_s': 'Req latency p95 (s)', 'ttft_p95_ms': 'TTFT p95 (ms)', 'itl_p95_ms': 'ITL p95 (ms)', 'tpot_p95_ms': 'TPOT p95 (ms)'} %}
  <div class="section-title" style="margin-top:10px">GPU-to-GPU comparison — {{ 'FLAG' if (m.delta.status | default('ok')) == 'flag' else 'ok' }} (tolerance &plusmn;{{ m.delta.variance_pct | float | round(0) | int }}%)</div>
  {% if (m.delta.confidence | default('ok')) == 'low' %}<div class="mini-pre">Low confidence: the weakest GPU completed only {{ m.delta.min_samples | default('?') }} successful requests — too few to distinguish a real hardware difference from single-run variance, so no GPU is flagged as an outlier here.</div>{% endif %}
  <div class="table-scroll"><table class="gtable"><thead><tr><th>Metric</th><th class="num">Best</th><th class="num">Worst</th><th class="num">Spread %</th><th>Flagged / note</th><th>Status</th></tr></thead><tbody>
  {% for r in m.delta.metrics %}<tr><td>{{ _dlabels[r.metric] | default(r.metric) }}</td><td class="num">{{ r.best }}</td><td class="num">{{ r.worst }}</td><td class="num">{{ r.spread_pct }}</td><td>{% if (r.flagged_gpus | default([]) | length > 0) %}{{ r.flagged_gpus | map('regex_replace', '^', 'GPU ') | join(', ') }}{% elif r.note | default('') %}{{ r.note }}{% else %}—{% endif %}</td><td>{{ 'ok' if r.ok else 'FLAG' }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% endif %}
  {# A failed backend prints its headline PLUS the captured evidence tail (the
     stack waits print a greppable verdict line last) and where the full log
     lives — a bare "non-zero return code" is not a diagnosis. #}
  {% if (m.status | default('')) == 'failed' and (_okg | length == 0) and (m.error is defined) %}<div class="mini-pre">Failed: {{ m.error | default('unknown error') | e }}{% if m.error_detail | default([]) | length > 0 %}
<strong>Evidence (tail):</strong>
{% for _el in m.error_detail %}{{ _el | e }}
{% endfor %}{% endif %}{% if m.error_log | default('') %}Full log on the frontend: {{ m.error_log | e }}{% endif %}</div>{% endif %}
  {% endfor %}
  {% set _bd = data.baseline_delta | default({}) %}
  {% if _bd and (_bd.rows | default([]) | length > 0) %}
  <div class="section-title" style="margin-top:14px">Virtualization overhead vs bare-metal baseline — {{ 'FLAG' if (_bd.status | default('ok')) == 'flag' else 'ok' }} (tolerance {{ _bd.tolerance_pct | float | round(0) | int }}%)</div>
  <div class="mini-pre">Bare-metal baseline recorded pre-deploy{% if _bd.baseline_timestamp | default('') %} on {{ _bd.baseline_timestamp }}{% endif %} (gpu_baseline.json). Positive overhead = the virtualized deployment is slower than bare metal.{% for c in _bd.caveats | default([]) %} {{ c }}{% endfor %}</div>
  {# Rows with BOTH sides measured feed the narrative + the combined chart. #}
  {% set _bdn = [] %}
  {% for r in _bd.rows %}{% if (r.baremetal | string | length > 0) and (r.virtualized | string | length > 0) and ((r.baremetal | float) > 0) and ((r.virtualized | float) > 0) %}{% if _bdn.append(r) %}{% endif %}{% endif %}{% endfor %}
  {% if _bdn | length > 0 %}
  {% set _tol = _bd.tolerance_pct | default(10) | float %}
  {# ' [k8s]' variants (the in-cluster probe) count as hardware rows too,
     so the within-N% summary covers the worst of both environments. #}
  {% set _hwrows = _bdn | selectattr('metric', 'search', '^(cuBLAS GFLOP/s|PCIe (H2D|D2H) GB/s)( \\[k8s\\])?$') | list %}
  {% set _thr_rows = _bdn | selectattr('metric', 'search', 'tok/s|sustained') | list %}
  {% set _ttft_rows = _bdn | selectattr('metric', 'search', 'TTFT') | list %}
  {# Within-tolerance is judged STRICTLY on overhead_pct — rows kept 'ok' only
     by a measurement guard (low samples / throughput floor) are listed apart,
     never silently counted as green. #}
  {% set _okc = [] %}{% set _guarded = [] %}
  {% for r in _bdn %}{% if (r.overhead_pct | float) <= _tol %}{% if _okc.append(r) %}{% endif %}{% elif r.ok %}{% if _guarded.append(r) %}{% endif %}{% endif %}{% endfor %}
  <div class="mini-pre"><strong>Summary:</strong>
  {%- if _hwrows | length > 0 %}{% set _hww = _hwrows | map(attribute='overhead_pct') | map('float') | map('abs') | max %} Raw GPU compute and PCIe bandwidth run within {{ _hww | round(1) }}% of bare metal{{ ' (virtualization overhead is negligible at the hardware level)' if (_hww | float) <= 3 else '' }}.{% endif %}
  {%- for r in _thr_rows %} {{ 'LLM throughput (' ~ r.metric ~ ') is ' ~ (r.overhead_pct | float | abs | round(1)) ~ '% ' ~ ('BELOW' if (r.overhead_pct | float) > 0 else 'above') ~ ' the bare-metal baseline.' }}{% endfor %}
  {%- for r in _ttft_rows %} {{ 'Time to first token' ~ ((' (' ~ (r.metric.split(' — ') | first) ~ ')') if (_ttft_rows | length > 1) else '') ~ ' is ' ~ (r.overhead_pct | float | abs | round(1)) ~ '% ' ~ ('higher' if (r.overhead_pct | float) > 0 else 'lower') ~ ' than bare metal.' }}{% endfor %}
  {{ _okc | length }}/{{ _bdn | length }} compared metrics fall within the &plusmn;{{ _tol | round(0) | int }}% tolerance{% if _guarded | length > 0 %}; {{ _guarded | length }} exceed it but are not flagged because a measurement guard applies ({{ _guarded | map(attribute='metric') | join(', ') }} — see the notes in the table){% endif %}{{ ' — see the caveats above before reading these as pure virtualization cost' if (_bd.caveats | default([]) | length > 1) else '' }}.</div>
  {# One chart, both runs: bare-metal is the 100% reference bar, each metric bar
     is the virtualized result relative to it (higher-better inverted for
     latencies so MORE is always BETTER). Colors follow the table verdict. #}
  {% set _cmp_bars = [] %}
  {% if _cmp_bars.append({'label': 'Baseline', 'value': 100.0, 'color': '#94a3b8'}) %}{% endif %}
  {# Two separate label dimensions: BACKEND ('vm '/'k8s ' prefixes, only
     when a [k8s] row exists — otherwise appliance/k8s rows would render
     identical labels told apart only by color) and MODEL (short tail,
     only when several models really ran). #}
  {% set _has_k8s_rows = (_bdn | selectattr('metric', 'search', '\\[k8s\\]') | list | length) > 0 %}
  {% set _model_names = [] %}
  {% for r0 in _bdn %}{% if ' — ' in r0.metric %}{% set _mn = (r0.metric.split(' — ') | first).replace(' [k8s]', '') %}{% if _mn not in _model_names %}{% if _model_names.append(_mn) %}{% endif %}{% endif %}{% endif %}{% endfor %}
  {% set _multi = (_model_names | length) > 1 %}
  {% for r in _bdn %}
  {% set _bmv = r.baremetal | float %}{% set _vv = r.virtualized | float %}
  {% set _rel = (_vv / _bmv * 100) if (r.better | default('higher')) == 'higher' else (_bmv / _vv * 100) %}
  {% set _col = '#15803d' if _rel >= 100 else ('#1a7ba4' if r.ok else '#b91c1c') %}
  {# Kind detection on the metric BASE so ' [k8s]' hardware variants keep
     their short names; the backend tag then applies to every row (with a
     k8s hw probe, 'cuBLAS' would otherwise label two different bars). #}
  {% set _mbase = r.metric.replace(' [k8s]', '') %}
  {% set _kind = ('cuBLAS' if _mbase == 'cuBLAS GFLOP/s' else ('PCIe H2D' if _mbase == 'PCIe H2D GB/s' else ('PCIe D2H' if _mbase == 'PCIe D2H GB/s' else ('tok/s' if 'output tok/s' in r.metric else ('req/s' if 'sustained' in r.metric else ('TTFT' if 'TTFT' in r.metric else (r.metric | truncate(9, true, '')))))))) %}
  {% set _btag = ('k8s ' if ('[k8s]' in r.metric) else ('vm ' if _has_k8s_rows else '')) %}
  {% set _mtail = ((((r.metric.split(' — ') | first).replace(' [k8s]', '').split('/') | last) | truncate(8, true, '…')) ~ ' ') if (_multi and (' — ' in r.metric)) else '' %}
  {% set _lbl = _mtail ~ _btag ~ _kind %}
  {% if _cmp_bars.append({'label': _lbl, 'value': _rel | round(1), 'color': _col}) %}{% endif %}
  {% endfor %}
  {{ bar_chart('Virtualized performance relative to bare-metal (100% = baseline; more is better)', _cmp_bars, '%') }}
  {% endif %}
  {# ENVIRONMENT-COLUMN table: one row per metric, one value column per
     backend that ran ('[k8s]' row variants merge into their base row),
     PLUS the dedicated Overhead % and Status columns of the original
     table ('vm / k8s' pairs when both backends ran). Guard notes are
     numbered footnotes anchored on the overhead value they apply to.
     Hardware rows come from the appliance-side health VM (vm column) and
     from the in-cluster hw probe ('<metric> [k8s]' rows) — a Kubernetes
     cell stays '—' only when the probe did not produce that value. This
     table replaces the former separate three-way summary (the NUMA caveat
     lives in the caveats paragraph above, emitted by compare_baseline). #}
  {% set _has_k8s_col = (_bd.rows | selectattr('metric', 'search', '\\[k8s\\]') | list | length) > 0 %}
  {% set _obase = [] %}
  {% for r in _bd.rows %}{% set _b0 = r.metric.replace(' [k8s]', '') %}{% if _b0 not in _obase %}{% if _obase.append(_b0) %}{% endif %}{% endif %}{% endfor %}
  {# Footnotes collected in the OUTER scope (a list mutated inside a macro
     is not reliably visible outside across jinja/ansible versions — the
     macros only LOOK UP the index). #}
  {% set _fnotes = [] %}
  {% for r in _bd.rows %}{% if (r.note | default('') | length > 0) and (r.note not in _fnotes) %}{% if _fnotes.append(r.note) %}{% endif %}{% endif %}{% endfor %}
  {% macro _vcell(r) %}{{ (r.virtualized | float | round(2)) if (r and (r.virtualized | default('') | string | length > 0)) else '—' }}{% endmacro %}
  {% macro _opct(r, fnotes) %}{% if r and (r.overhead_pct | default('') | string | length > 0) %}{{ r.overhead_pct }}%{% else %}—{% endif %}{% if r and (r.note | default('') | length > 0) %}<sup>{{ fnotes.index(r.note) + 1 }}</sup>{% endif %}{% endmacro %}
  <div class="table-scroll"><table class="gtable"><thead><tr><th>Metric</th><th class="num">Bare-metal</th><th class="num">{{ 'vLLM appliance' if _has_k8s_col else 'Virtualized' }}</th>{% if _has_k8s_col %}<th class="num">Kubernetes</th>{% endif %}<th class="num">Overhead %{{ ' (vm / k8s)' if _has_k8s_col else '' }}</th><th>Status</th></tr></thead><tbody>
  {% for _b0 in _obase %}
  {# LLM metrics carry the backend inside the name ('<model> [k8s] — <kind>'),
     hardware metrics append it ('cuBLAS GFLOP/s [k8s]' from the in-cluster
     probe) — both resolve to the base row's Kubernetes cell. #}
  {% set _kname = _b0.replace(' — ', ' [k8s] — ', 1) if (' — ' in _b0) else (_b0 ~ ' [k8s]') %}
  {% set _vmr = _bd.rows | selectattr('metric', 'eq', _b0) | list | first | default(none) %}
  {% set _k8r = (_bd.rows | selectattr('metric', 'eq', _kname) | list | first | default(none)) if (_kname | length > 0) else none %}
  {% set _bare = (_vmr.baremetal if (_vmr and (_vmr.baremetal | string | length > 0)) else ((_k8r.baremetal | default('')) if _k8r else '')) %}
  {% set _flags = [] %}
  {% if _vmr and not _vmr.ok %}{% if _flags.append('vm') %}{% endif %}{% endif %}
  {% if _k8r and not _k8r.ok %}{% if _flags.append('k8s') %}{% endif %}{% endif %}
  {% set _status = '—' if (not _vmr and not _k8r) else ('ok' if _flags | length == 0 else ('FLAG' if not _has_k8s_col else 'FLAG (' ~ _flags | join(', ') ~ ')')) %}
  <tr><td>{{ _b0 }}</td><td class="num">{{ (_bare | float | round(2)) if (_bare | string | length > 0) else '—' }}</td><td class="num">{{ _vcell(_vmr) }}</td>{% if _has_k8s_col %}<td class="num">{{ _vcell(_k8r) }}</td>{% endif %}<td class="num">{{ _opct(_vmr, _fnotes) }}{% if _has_k8s_col %} / {{ _opct(_k8r, _fnotes) }}{% endif %}</td><td>{{ _status }}</td></tr>
  {% endfor %}
  </tbody></table></div>
  <div class="mini-pre">Overhead % is signed so POSITIVE always means worse than bare metal (throughput lower / latency higher).{% if _fnotes | length > 0 %} Notes: {% for n in _fnotes %}{{ loop.index }}. {{ n }}{{ ' · ' if not loop.last else '' }}{% endfor %}{% endif %}</div>
  {% endif %}
  {% endfor %}
  <div class="section-title" style="margin-top:16px">Legend — terms and abbreviations</div>
  <div class="table-scroll"><table class="gtable"><thead><tr><th style="width:22%">Term</th><th>Meaning</th></tr></thead><tbody>
  <tr><td colspan="2"><strong>LLM latency &amp; load</strong></td></tr>
  <tr><td>TTFT</td><td>Time To First Token — delay before the first token of the answer appears; what a user perceives as responsiveness</td></tr>
  <tr><td>ITL</td><td>Inter-Token Latency — gap between consecutive output tokens while the answer streams</td></tr>
  <tr><td>TPOT</td><td>Time Per Output Token — average generation time per output token</td></tr>
  <tr><td>p95</td><td>95th percentile — 95% of requests performed at least this well; captures the near-worst-case experience rather than the average</td></tr>
  <tr><td>sync</td><td>synchronous run — one request at a time, no concurrency; isolates pure latency</td></tr>
  <tr><td>sat</td><td>saturated — the PEAK-throughput point of the load sweep (the maximum sustained generation rate; loads beyond it collapse into queueing)</td></tr>
  <tr><td>req/s, tok/s</td><td>requests per second; generated output tokens per second</td></tr>
  <tr><td>Sustained req/s</td><td>saturated output-token rate &divide; tokens per request — the steady-state request rate the GPU holds</td></tr>
  <tr><td>Avg concurrency</td><td>average number of requests in flight during a load step</td></tr>
  <tr><td colspan="2"><strong>Hardware diagnostics</strong></td></tr>
  <tr><td>cuBLAS SGEMM</td><td>NVIDIA linear-algebra benchmark (single-precision matrix multiply) — raw GPU compute</td></tr>
  <tr><td>GFLOP/s</td><td>billions of floating-point operations per second</td></tr>
  <tr><td>PCIe H2D / D2H</td><td>Host-to-Device / Device-to-Host copy bandwidth over the PCIe bus (GB/s) — the CPU&harr;GPU data path</td></tr>
  <tr><td>PCIe width (x8/x16)</td><td>number of PCIe lanes the GPU link negotiated vs the card maximum</td></tr>
  <tr><td>DCGM</td><td>NVIDIA Data Center GPU Manager — the vendor GPU diagnostic/acceptance suite</td></tr>
  <tr><td>ECC</td><td>Error-Correcting Code memory — uncorrected error counter (0 is healthy)</td></tr>
  <tr><td>SM clock</td><td>Streaming Multiprocessor (GPU core) frequency, MHz</td></tr>
  <tr><td>VBIOS</td><td>GPU firmware version</td></tr>
  <tr><td>Compute cap</td><td>CUDA compute capability — the GPU architecture generation</td></tr>
  <tr><td>VRAM</td><td>GPU on-board memory</td></tr>
  <tr><td colspan="2"><strong>Verdicts &amp; method</strong></td></tr>
  <tr><td>SLO</td><td>Service Level Objective — the performance gate a metric is judged against</td></tr>
  <tr><td>(ref)</td><td>the gate came from the hardware-calibrated reference table for this GPU/model, not from the global profile</td></tr>
  <tr><td>FLAG / WARN</td><td>a check outside tolerance — informational; the validation continues and reports it</td></tr>
  <tr><td>not evaluated</td><td>no numeric gate configured for this GPU/model (calibration run) — the metric was measured but not judged</td></tr>
  <tr><td>Sweep truncated</td><td>the tested load ladder never reached the throughput knee (guidellm derives it from a chaotic probe) — the reported throughput is a lower bound, and throughput gaps against the affected GPU are not flagged; '*' on an SLO verdict = the throughput gate was inconclusive (lower bound below the gate)</td></tr>
  <tr><td>Sweep unsaturated</td><td>the load generator landed in its slow client mode and under-measured the probe, so the rate ladder stopped below the knee — same lower-bound treatment as a truncated sweep; the benchmark retries once automatically when this is detected</td></tr>
  <tr><td>TP</td><td>tensor parallelism — splitting one model across N GPUs; TP=1 means each GPU serves the whole model alone</td></tr>
  <tr><td>vLLM / GuideLLM</td><td>the inference server, respectively the load-generator tool driving the benchmark</td></tr>
  <tr><td>Tokens per watt</td><td>energy efficiency — output tokens/s &divide; average GPU power draw during the run</td></tr>
  <tr><td>Bare-metal baseline</td><td>pre-deploy run executed directly on the host OS; "Overhead %" compares the virtualized deployment against it (positive = virtualized slower)</td></tr>
  </tbody></table></div>
  </section>
  {% endif %}

  {% if validation_vars.run_network_benchmark | default(false) and network_benchmark is defined and network_benchmark | length > 0 %}
  <section class="data-section"><div class="section-title">Network Benchmarking Results</div><div class="section-title" style="margin-top:14px">Throughput (iperf3)</div><div class="table-scroll"><table class="gtable bench-table"><colgroup><col style="width:38%"><col style="width:38%"><col style="width:24%"></colgroup><thead><tr><th>Client host</th><th>Server</th><th class="num">Throughput</th></tr></thead><tbody>{% for host, data in network_benchmark.items() %}{% if data.iperf_results is defined and data.iperf_results.results is defined %}{% for it in data.iperf_results.results %}{% set bps = it.stdout | default('0') | float %}{% set server_name = ip_to_hostname.get(it.item) if ip_to_hostname is defined else None %}<tr><td>{{ host }}</td><td>{{ server_name | default(it.item, true) }}</td><td class="num">{{ '%.2f' | format(bps / 1000000.0) }} Mbps</td></tr>{% endfor %}{% else %}<tr><td colspan="3">No iperf3 results for {{ host }}</td></tr>{% endif %}{% endfor %}</tbody></table></div><div class="section-title" style="margin-top:18px">Ping (average RTT)</div><div class="table-scroll"><table class="gtable bench-table"><colgroup><col style="width:38%"><col style="width:38%"><col style="width:24%"></colgroup><thead><tr><th>Source host</th><th>Destination</th><th class="num">Avg RTT</th></tr></thead><tbody>{% for host, data in network_benchmark.items() %}{% if data.ping_exec is defined and data.ping_exec.results is defined %}{% for it in data.ping_exec.results %}{% set rtt_raw = it.stdout | default('') %}{% set dest_name = ip_to_hostname.get(it.item) if ip_to_hostname is defined else None %}<tr><td>{{ host }}</td><td>{{ dest_name | default(it.item, true) }}</td><td class="num">{% if rtt_raw != '' and rtt_raw != 'null' %}{{ '%.2f' | format(rtt_raw | float) }} ms{% else %}N/A{% endif %}</td></tr>{% endfor %}{% else %}<tr><td colspan="3">No ping results for {{ host }}</td></tr>{% endif %}{% endfor %}</tbody></table></div></section>
  {% endif %}

  {% include "connectivity-matrix.j2" %}

  <section class="data-section"><div class="section-title">Variables Used For Validation</div><pre>{{ validation_vars | to_nice_yaml }}</pre></section>
  <div class="footer"><div>OpenNebula Cloud Verification</div><div><a href="https://docs.opennebula.io/" target="_blank" rel="noopener">OpenNebula Docs</a>&nbsp;.&nbsp;<a href="https://github.com/OpenNebula/one-deploy" target="_blank" rel="noopener">one-deploy GitHub</a></div></div>
</div>
<script>
var PCT={{ pct }};
window.addEventListener('load',function(){var fill=document.getElementById('pgfill');var lbl=document.getElementById('pct-lbl');if(fill&&lbl){fill.style.width=PCT+'%';lbl.textContent=PCT+'% passing';}});
function toggleTable(tableId,toggleId){var table=document.getElementById(tableId);var toggle=document.getElementById(toggleId);if(!table||!toggle)return;if(table.style.display==='none'){table.style.display='';toggle.textContent='v';}else{table.style.display='none';toggle.textContent='>';}}
</script>
</body>
</html>
